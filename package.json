		"@types/cookie": "^0.6.0",
		"autoprefixer": "^10.4.19",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"postcss": "^8.4.38",
